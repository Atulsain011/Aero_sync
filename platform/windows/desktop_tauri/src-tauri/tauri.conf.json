{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AeroSync",
  "version": "1.0.7",
  "identifier": "com.aerosync.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AeroSync",
        "width": 1080,
        "height": 740,
        "minWidth": 880,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "center": true,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "AeroSync Ultra High-Speed P2P Desktop Client",
    "longDescription": "AeroSync is an ultra high-speed peer-to-peer file transfer desktop application built with C++ and Tauri.",
    "resources": [
      "aerosync_daemon*"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1",
          "librsvg2-2"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}
