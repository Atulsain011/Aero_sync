#include <windows.h>

101 ICON "assets/icon.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,6,0
PRODUCTVERSION  1,0,6,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "AeroSync"
            VALUE "FileDescription",  "AeroSync Peer-to-Peer Direct File Transfer Engine"
            VALUE "FileVersion",      "1.0.6.0"
            VALUE "InternalName",     "AeroSync"
            VALUE "LegalCopyright",   "Copyright (C) 2026 AeroSync. All rights reserved."
            VALUE "OriginalFilename", "AeroSync.exe"
            VALUE "ProductName",      "AeroSync"
            VALUE "ProductVersion",   "1.0.6.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
